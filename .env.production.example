# Plantilla del .env de producción. scripts/deploy.sh la copia al servidor la primera vez
# y reemplaza cada __GEN__ por un secreto aleatorio y __DOMAIN__ por el dominio.
# El archivo real vive sólo en /srv/datecito/backend/.env del servidor.

APP_NAME=Datecito
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.__DOMAIN__

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

HASH_DRIVER=argon2id

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=datecito
DB_USERNAME=datecito
DB_PASSWORD=__GEN__
DB_ROOT_PASSWORD=__GEN__

SESSION_DRIVER=redis
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=__GEN__
REDIS_PORT=6379

# Correo transaccional (códigos de verificación). Brevo: smtp-relay.brevo.com / 587 / tls.
# Hasta que se configure, los correos se escriben en el log y nadie puede verificar su cuenta.
MAIL_MAILER=log
MAIL_LOG_CHANNEL=mail
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hola@__DOMAIN__
MAIL_FROM_NAME=Datecito

# Fotos. Hoy: SeaweedFS en el mismo servidor. Para Cloudflare R2 basta cambiar
# AWS_ENDPOINT/AWS_PUBLIC_ENDPOINT por el endpoint de R2 y las llaves por las de R2.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=__GEN__
AWS_SECRET_ACCESS_KEY=__GEN__
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=datecito-photos
AWS_ENDPOINT=http://storage:8333
AWS_PUBLIC_ENDPOINT=https://fotos.__DOMAIN__
AWS_USE_PATH_STYLE_ENDPOINT=true

# Reglas de negocio
DATECITO_LAUNCH_FREE=true
DATECITO_FAKE_PURCHASES=false
DATECITO_AUTO_VERIFY=false
DATECITO_TIMEZONE=America/Mexico_City
DATECITO_CRM_URL=https://crm.__DOMAIN__
DATECITO_WEB_URL=https://__DOMAIN__
# A quién avisar por correo cuando llega un formulario del sitio (deben existir como buzones o reenvíos).
DATECITO_NOTIFY_SUPPORT=ayuda@__DOMAIN__
DATECITO_NOTIFY_PARTNERS=alianzas@__DOMAIN__
DATECITO_NOTIFY_PRIVACY=privacidad@__DOMAIN__
DATECITO_CRM_CACHE=60

# Caddy (docker-compose.prod.yml)
DOMAIN=__DOMAIN__
ACME_EMAIL=__ACME_EMAIL__
