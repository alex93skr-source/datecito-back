# Entrada única del servidor. HTTPS automático con Let's Encrypt para cada subdominio.
{
	email {$ACME_EMAIL}
}

(seguridad) {
	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Sitio público (React, una sola página)
{$DOMAIN} {
	import seguridad
	root * /srv/web
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	# La raíz manda a la versión en español (x-default); cada página tiene su HTML prerenderizado.
	@root path /
	redir @root /es/ 302
	try_files {path} {path}/index.html /index.html
	file_server
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

# API Laravel
api.{$DOMAIN} {
	import seguridad
	encode zstd gzip
	reverse_proxy nginx:80
}

# CRM interno (React, una sola página)
crm.{$DOMAIN} {
	import seguridad
	root * /srv/crm
	encode zstd gzip
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

# Fotos: sólo enlaces firmados generados por la API (caducan en 30 min)
fotos.{$DOMAIN} {
	header -Server
	reverse_proxy storage:8333
}
